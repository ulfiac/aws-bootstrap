{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday packages",
      "matchPackageNames": [
        "actions/checkout",
        "aws-actions/configure-aws-credentials",
        "hashicorp/aws",
        "hashicorp/setup-terraform",
        "hashicorp/terraform"
      ],
      "minimumReleaseAge": "7 days",
      "reviewers": [
        "ulfiac"
      ],
      "schedule": [
        "before 9am on monday"
      ]
    },
    {
      "automerge": true,
      "groupName": "commons packages",
      "matchPackageNames": [
        "ulfiac/commons"
      ]
    },
    {
      "automerge": true,
      "groupName": "container packages",
      "matchPackageNames": [
        "ghcr.io/ulfiac/terragrunt-runner"
      ]
    },
    {
      "description": "actionlint 1.7.12 does not support ubuntu-26.04 runners; pin until it does (see ulfiac/commons#200)",
      "matchDepTypes": [
        "github-runner"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "24.04"
    }
  ],
  "prHourlyLimit": 5,
  "timezone": "America/New_York"
}
