{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": [
    "ulfiac"
  ],
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "renovate"
  ],
  "packageRules": [
    {
      "groupName": "Monday packages",
      "matchPackageNames": [
        "actions/checkout",
        "aws-actions/configure-aws-credentials",
        "hashicorp/aws",
        "hashicorp/setup-terraform",
        "hashicorp/terraform"
      ]
    }
  ],
  "prHourlyLimit": 5,
  "reviewers": [
    "ulfiac"
  ],
  "timezone": "America/New_York"
}
